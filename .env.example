# Django Settings
# Generate a secure SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (PostgreSQL for production)
# For development with SQLite, use:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
DB_ENGINE=django.db.backends.postgresql
DB_NAME=emr_db
DB_USER=emr_user
DB_PASSWORD=your-secure-password-here
DB_HOST=localhost
DB_PORT=5432

# Redis (for caching)
REDIS_URL=redis://localhost:6379/1

# CORS (comma-separated list of allowed origins)
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# SMS Configuration (Nigeria: Termii recommended; or twilio / console for dev)
SMS_ENABLED=True
SMS_PROVIDER=termii
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=ClinicName
TERMII_BASE_URL=https://api.termii.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Twilio Video (Telemedicine)
TWILIO_API_KEY=your-api-key-sid
TWILIO_API_SECRET=your-api-secret
TWILIO_RECORDING_ENABLED=False

# Paystack (Payment Gateway)
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_CALLBACK_URL=https://yourdomain.com/wallet/callback

# Clinic Information
CLINIC_NAME=Your Clinic Name
CLINIC_ADDRESS=Your Clinic Address
CLINIC_PHONE=+234-XXX-XXXX
CLINIC_EMAIL=info@yourdomain.com

# Backup Configuration
BACKUP_RETENTION_DAYS=30

# PACS-lite Configuration (Optional)
# OHIF_VIEWER_URL=https://your-ohif-viewer-url.com
# RADIOLOGY_SIGNED_URLS=True
# RADIOLOGY_STORAGE=None

# SaaS multi-tenancy (backend/.env or project root .env — see backend/load_env.py)
ENABLE_ORG_SIGNUP=true
REQUIRE_ORGANIZATION_CONTEXT=true

# Frontend URL (emails, payment callbacks)
FRONTEND_URL=http://localhost:3000

# SaaS subscription billing (Nigeria — Paystack default; or flutterwave)
SAAS_PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=

# Subdomain tenant routing (clinic1.yourdomain.com)
# TENANT_SUBDOMAIN_ENABLED=true
# TENANT_BASE_DOMAIN=yourdomain.com
