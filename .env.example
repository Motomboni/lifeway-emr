# Django Settings
# Generate a secure SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (PostgreSQL for production)
# For development with SQLite, use:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
DB_ENGINE=django.db.backends.postgresql
DB_NAME=emr_db
DB_USER=emr_user
DB_PASSWORD=your-secure-password-here
DB_HOST=localhost
DB_PORT=5432

# Redis (for caching)
REDIS_URL=redis://localhost:6379/1

# CORS (comma-separated list of allowed origins)
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# SMS Configuration (Nigeria: Termii recommended; or twilio / console for dev)
SMS_ENABLED=True
SMS_PROVIDER=termii
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=ClinicName
TERMII_BASE_URL=https://api.termii.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Twilio Video (Telemedicine) — when TELEMEDICINE_VIDEO_PROVIDER=twilio
TWILIO_API_KEY=your-api-key-sid
TWILIO_API_SECRET=your-api-secret
TWILIO_RECORDING_ENABLED=False
# Self-hosted LiveKit — start: docker compose -f docker-compose.livekit.yml up -d
TELEMEDICINE_VIDEO_PROVIDER=livekit
LIVEKIT_URL=ws://localhost:7880
# Must match infra/livekit/livekit.dev.yaml keys: section (generate with livekit-server generate-keys)
LIVEKIT_API_KEY=APIPefjr68gHmQM
LIVEKIT_API_SECRET=OCm9EYheltH4XelO3Y5Cx4GpCIgps04ZcpSL6YEtPzZ

# Telemedicine transcription (after recorded sessions)
TELEMEDICINE_AUTO_TRANSCRIPTION=True
# Provider: openai | faster-whisper
TRANSCRIPTION_PROVIDER=faster-whisper
# OpenAI Whisper API (when TRANSCRIPTION_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# Local faster-whisper (when TRANSCRIPTION_PROVIDER=faster-whisper; requires ffmpeg)
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_DEVICE=cpu
# FASTER_WHISPER_COMPUTE_TYPE=int8
# FASTER_WHISPER_LANGUAGE=en

# Paystack (Payment Gateway)
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_CALLBACK_URL=https://yourdomain.com/wallet/callback

# Clinic Information
CLINIC_NAME=Your Clinic Name
CLINIC_ADDRESS=Your Clinic Address
CLINIC_PHONE=+234-XXX-XXXX
CLINIC_EMAIL=info@yourdomain.com

# Backup Configuration
BACKUP_RETENTION_DAYS=30

# PACS-lite / Orthanc / MinIO (optional — use docker-compose.imaging.yml overlay)
# OHIF viewer via Orthanc plugin (same-origin proxy recommended)
# OHIF_VIEWER_URL=/ohif/viewer
# ORTHANC_URL=http://orthanc:8042
# ORTHANC_USERNAME=orthanc
# ORTHANC_PASSWORD=orthanc
# RADIOLOGY_SIGNED_URLS=True
# MinIO object storage for radiology files (when using imaging overlay)
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# AWS_S3_ENDPOINT_URL=http://minio:9000
# RADIOLOGY_STORAGE=storages.backends.s3boto3.S3Boto3Storage

# Lifeway single-clinic — one organization (default-clinic)
REQUIRE_ORGANIZATION_CONTEXT=false
ENFORCE_PLAN_LIMITS=false

# Frontend URL (emails, payment callbacks)
FRONTEND_URL=http://localhost:3000

# Paystack (visit billing — Nigeria)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
