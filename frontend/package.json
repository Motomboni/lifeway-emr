    "@tanstack/react-query": "^5.90.21",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.68",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^10.0.0",
    "dompurify": "^3.4.8",
    "framer-motion": "^12.42.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "livekit-client": "^2.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.6.0",
    "three": "^0.185.0",
    "twilio-video": "^2.33.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "vite",
    "prestart:clean": "node -e \"try{require('fs').rmSync('node_modules/.cache',{recursive:true});console.log('Cache cleared');}catch(e){}\"",
    "start:clean": "vite --force",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "serve": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "capture-manual-screenshots": "playwright test e2e/manual/capture-manual-screenshots.spec.ts --project=chromium"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.27",
    "@types/three": "^0.160.0",
    "@types/twilio-video": "^2.7.3",
    "@vitejs/plugin-react": "^4.2.1",
    "http-proxy-middleware": "^3.0.5",
    "vite": "^5.2.0"
  }
}
