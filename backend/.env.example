# Local development — copy to backend/.env or project root .env
# Django loads both via backend/load_env.py (root .env first, then backend/.env)

DEBUG=True
SECRET_KEY=django-insecure-change-in-production

# SQLite (default for local dev)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# SaaS: public clinic signup (POST /api/v1/organizations/signup/)
ENABLE_ORG_SIGNUP=true
REQUIRE_ORGANIZATION_CONTEXT=true

# SaaS subscription billing (Nigeria)
SAAS_PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# CORS for React dev server
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# SMS (Nigeria — Termii for OTP + appointment reminders)
SMS_ENABLED=true
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=Damianix

# Subdomain tenants (optional): clinic1.localhost
# TENANT_SUBDOMAIN_ENABLED=true
# TENANT_BASE_DOMAIN=localhost
