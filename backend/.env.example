# Local development — copy to backend/.env or project root .env
# Django loads both via backend/load_env.py (root .env first, then backend/.env)

DEBUG=True
SECRET_KEY=django-insecure-change-in-production

# SQLite (default for local dev)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Lifeway single-clinic — one organization (default-clinic)
REQUIRE_ORGANIZATION_CONTEXT=false
ENFORCE_PLAN_LIMITS=false

# Paystack (visit billing — Nigeria)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# CORS for React dev server
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# E2E only — expose OTP in API response (never enable in production)
# E2E_OTP_EXPOSE=true

# Backend tests (Windows): scripts/setup-backend-venv.ps1 then scripts/run-backend-tests.ps1
# Tests use SQLite via env vars (see scripts/run-backend-tests.ps1); do not rely on MSYS python.

# Optional Sentry
# SENTRY_DSN=
WEASYPRINT_DLL_DIRECTORIES=C:\msys64\ucrt64\bin

# SMS (Nigeria — Termii for OTP + appointment reminders)
SMS_ENABLED=true
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=Lifeway Medical Centre Ltd

# NHID verification (http = live API when configured; stub = dev)
NHID_VERIFICATION_MODE=stub
NHID_API_URL=
NHID_API_KEY=

# NHIA Claims Portal — reserved for future official API (no public API today).
# Claims use export CSV + manual portal upload + local status tracking in the EMR.
# NHIA_PORTAL_API_KEY=
# TENANT_SUBDOMAIN_ENABLED=true
# TENANT_BASE_DOMAIN=localhost
