# Production environment for Docker (docker-compose.prod.yml or docker-compose.standalone.yml)
# Copy to .env and set values: cp .env.prod.example .env
# See SECURITY_HARDENING.md for clinic-grade checklist.

# Required: MUST be a strong random value (min 32 chars). Generate: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-random-string

# Django
DEBUG=false
APP_VERSION=2.0.0
ALLOWED_HOSTS=localhost,127.0.0.1,backend,yourdomain.com,www.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# PostgreSQL (container name = db; set a strong password)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=emr_db
DB_USER=emr_user
DB_PASSWORD=your-secure-password-here
DB_HOST=db
DB_PORT=5432
# Optional: encrypt DB connection (require | verify-full for clinic-grade)
# DB_SSLMODE=require

# CORS: origins that will load the frontend (browser origin)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://yourdomain.com,https://www.yourdomain.com

# HTTPS / reverse proxy
# Set SECURE_SSL_REDIRECT=true if Django should redirect HTTP -> HTTPS.
# If nginx/load balancer handles redirects before traffic reaches Django, you may set this false.
SECURE_SSL_REDIRECT=true
SECURE_PROXY_SSL_HEADER=X-Forwarded-Proto

# Redis + Celery (required in production — appointment reminders, audit prune)
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email, SMS, Twilio Video, Paystack, etc. (copy from .env.example and set for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

SMS_ENABLED=True
SMS_PROVIDER=termii
# Termii (Nigeria-focused SMS - https://termii.com)
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.termii.com
# WhatsApp (Termii channel or Meta Cloud API)
WHATSAPP_PROVIDER=stub
TERMII_WHATSAPP_SENDER=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
WHATSAPP_STUB_ALWAYS_FAIL=false
# Twilio (alternative SMS provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_RECORDING_ENABLED=False
# Telemedicine (Twilio Video + Termii SMS invites)
TELEMEDICINE_VIDEO_PROVIDER=twilio
TELEMEDICINE_BILLING_SERVICE_CODE=TELEMED-001
TELEMEDICINE_AUTO_TRANSCRIPTION=True
# FRONTEND_URL must match public site — used for /telemedicine/room/{id} SMS links

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://yourdomain.com/wallet/callback

CLINIC_NAME=Lifeway Medical Centre Ltd
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_EMAIL=

BACKUP_RETENTION_DAYS=30
SCHEDULED_BACKUP_ENABLED=true
# Optional: copy nightly backups to mounted volume (NFS, backup disk)
# BACKUP_STORAGE_DIR=/mnt/backups

# Optional: Sentry error monitoring
# SENTRY_DSN=https://example@sentry.io/project
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Lifeway single-clinic production
REQUIRE_ORGANIZATION_CONTEXT=false
ENFORCE_PLAN_LIMITS=false

# Public registration — production defaults to PATIENT only (see settings.py)
PUBLIC_REGISTRATION_ENABLED=true
PUBLIC_REGISTRATION_ALLOWED_ROLES=PATIENT

# API docs and detailed health — off by default in production
API_DOCS_ENABLED=false
HEALTH_DETAILED_PUBLIC=false

# Optional one-time bootstrap admin. Do not keep real passwords in this file.
# Run from backend/: set DJANGO_SUPERUSER_PASSWORD then python create_superuser.py
# Skips if the username already exists.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_ROLE=ADMIN
# DJANGO_SUPERUSER_PASSWORD=

# NHID verification (http = live API when configured; stub = dev)
NHID_VERIFICATION_MODE=http
NHID_API_URL=
NHID_API_KEY=
# NHIA — no public API; export claim packs and track status manually in the EMR.
# NHIA_PORTAL_API_KEY=  # reserved for future official integration
# EMR_DATA_DIR=/app

# Subdomain routing (disabled for Lifeway single-clinic)
TENANT_SUBDOMAIN_ENABLED=false
TENANT_BASE_DOMAIN=yourdomain.com

# Radiology — Orthanc DICOMweb + OHIF (docker-compose.imaging.yml overlay)
# OHIF_VIEWER_URL=/ohif/viewer
# ORTHANC_URL=http://orthanc:8042
# ORTHANC_USERNAME=orthanc
# ORTHANC_PASSWORD=change-me-orthanc-password
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=change-me-minio-password
# AWS_S3_ENDPOINT_URL=http://minio:9000
# RADIOLOGY_STORAGE=storages.backends.s3boto3.S3Boto3Storage

# Security (optional overrides; defaults are clinic-grade)